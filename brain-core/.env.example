# Required secrets
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
BRAIN_SHARED_TOKEN=your-shared-token
BRAIN_TELEGRAM_KEY=your-telegram-key

# Optional overrides
BRAIN_URL=http://brain-api:8000
BRAIN_DB_PATH=/app/data/brain.db
TZ=Europe/Rome
BRAIN_BOT_RATE_LIMIT_SECONDS=1.0

# Daily digest
DIGEST_ENABLED=false
DIGEST_TIME=08:00
DIGEST_CHAT_IDS=123456789,987654321
